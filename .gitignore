# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the example file is the only one that is committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite database + dev server log
/dev.db
/dev.db-journal
/prisma/dev.db
/dev-server.log
/dev-server.err.log

# documents uploaded to the local-disk storage backend
/.koru-uploads/

# agent tooling
/.agents
/.claude
/.windsurf
/skills-lock.json

# local UI review screenshots
/ui-review-*.png

/src/generated/prisma
