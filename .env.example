# Copy to .env and adjust. Only DATABASE_URL is required; everything else
# switches an integration from its built-in local mode to a real service.

# SQLite database file (created by `npx prisma migrate deploy`).
DATABASE_URL="file:./dev.db"

# Task and checklist generation. Without a key, a deterministic rule-based
# planner is used instead.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Email (reminders, digests). Without a key, emails are printed to the server log.
# RESEND_API_KEY=
# RESEND_FROM=

# Document storage. Without these, uploads are written to ./.koru-uploads/.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=koru-documents

# Account used by the one-tap demo sign-in on the login page.
# DEMO_EMAIL=demo@koru.fj
